<div class="row">
    <div class="col s10 offset-s1 m8 offset-m2 l8 offset-l2">
        <div class="brand">
            <div class="title center-align">
                <% if (config.subtitle && config.subtitle.length > 0) { %>
                <%= config.subtitle %>
                <% } else { %>
                    subtitle
                <% } %>
            </div>

            <% if (theme.subDesc && theme.subDesc.enable && theme.subDesc.text) { %>
<div class="hero-subdesc"><%= theme.subDesc.text %></div>
<% } %>
<div class="description center-align">
                <% if (theme.subtitle.enable) { %>
                <% if (theme.motto && theme.motto.enable && theme.motto.texts && theme.motto.texts.length) { %>
<div class="hero-motto" id="hero-motto">
  <% theme.motto.texts.forEach(function(line, i) { %>
    <span class="hero-motto-line<% if (i===0) { %> is-active<% } %>" data-idx="<%= i %>"><%= line %></span>
  <% }); %>
</div>
<script>
(function(){
  var lines=document.querySelectorAll('#hero-motto .hero-motto-line');
  if(!lines.length)return;
  var i=0;
  setInterval(function(){
    lines[i].classList.remove('is-active');
    i=(i+1)%lines.length;
    lines[i].classList.add('is-active');
  },3000);
})();
</script>
<% } %>
<% if (theme.motto && theme.motto.enable && theme.motto.texts && theme.motto.texts.length) { %>
<% } %>
<span id="subtitle"></span>
                <script defer src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.typed) %>"></script>
                <script>
                    // typed.js is deferred, so it is only guaranteed to be
                    // defined once DOMContentLoaded fires.
                    document.addEventListener('DOMContentLoaded', function () {
                        var typed = new Typed("#subtitle", {
                            strings: [
                                <% theme.subtitle.sub.forEach(function(item){%>
                                    "<%= item %>",
                                <% }) %>
                            ],
                            startDelay: <%= theme.subtitle.startDelay %>,
                            typeSpeed: <%= theme.subtitle.typeSpeed %>,
                            loop: <%= theme.subtitle.loop %>,
                            backSpeed: <%= theme.subtitle.backSpeed %>,
                            showCursor: <%= theme.subtitle.showCursor %>
                        });
                    });
                </script>
                <% } else { %>
                    <%= config.description %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<% if (theme.banner.enable) { %>
<script>
    // 每天切换 banner 图.  Switch banner image every day.
    var bannerUrl = "<%- theme.jsDelivr.url %><%- url_for('/medias/banner/') %>" + new Date().getDay() + '.jpg';
    document.querySelectorAll('.bg-cover').forEach(function (el) {
        el.style.backgroundImage = 'url(' + bannerUrl + ')';
    });
</script>
<script>
    <% if (theme.banner.enable && theme.banner.random) { %>
      var bannerUrl = "<%- theme.jsDelivr.url %><%- url_for('/medias/featureimages/') %>" + Math.floor(Math.random() * <%- theme.featureImages.length %>) + '.jpg';
    <% } else { %>
      // 每天切换 banner 图.  Switch banner image every day.
      var bannerUrl = "<%- theme.jsDelivr.url %><%- url_for('/medias/banner/') %>" + new Date().getDay() + '.jpg';
    <% } %>
    document.querySelectorAll('.bg-cover.about-cover').forEach(function (el) {
        el.style.backgroundImage = 'url(' + bannerUrl + ')';
    });

</script>
<% } else { %>
<script>
    document.querySelectorAll('.bg-cover').forEach(function (el) {
        el.style.backgroundImage = 'url(<%- theme.jsDelivr.url %><%- url_for('/medias/banner/0.jpg') %>)';
    });
</script>
<% } %>
