<%/*
  最新一期：首页上那一块期号入口。

  数据来自 ``source/_data/podcast_index.json``
  （``tools/build-podcast-index.py`` 的产物），与文章页的期号区块
  同一个数据源——首页与期号页说的必须是同一件事。

  **这里不放播放器**：B站播放器要拉 1 MB 左右的 JS，首页是全站最热的
  页面，不该为了一块入口付这个钱。播放器在期号页上——那里才是
  「我要看视频」的地方。首页只负责把人引过去。

  没有期号索引时（数据还没生成）这一块不渲染，首页照常。
*/%>
<%
var podcastIndex = (site.data && site.data.podcast_index) ? site.data.podcast_index : null;
var podcastRows = (podcastIndex && podcastIndex.episodes) ? podcastIndex.episodes : [];
/* 期号索引按期号升序排，最后一条就是最新一期。 */
var latestEpisode = podcastRows.length ? podcastRows[podcastRows.length - 1] : null;
var latestLinks = [];
if (latestEpisode && latestEpisode.platforms) {
  latestEpisode.platforms.forEach(function (item) {
    if (item.published_url) { latestLinks.push(item); }
  });
}
%>
<% if (latestEpisode) { %>
<div class="latest-episode" data-aos="fade-up">
  <div class="latest-episode-inner">
    <div class="latest-episode-label"><i class="fas fa-video"></i>&nbsp;最新一期</div>
    <div class="latest-episode-head">
      <span class="episode-no"><%= latestEpisode.episode_label %></span>
      <span class="latest-episode-title"><%= latestEpisode.title %></span>
      <% if (latestEpisode.series) { %>
      <span class="episode-series"><%= latestEpisode.series %></span>
      <% } %>
    </div>
    <% if (latestEpisode.hook) { %>
    <div class="latest-episode-hook"><%= latestEpisode.hook %></div>
    <% } %>
    <div class="latest-episode-actions">
      <a class="latest-episode-link" href="<%- url_for(latestEpisode.url) %>">看这一期</a>
      <% latestLinks.forEach(function (item) { %>
      <a class="latest-episode-platform" href="<%- item.published_url %>" target="_blank" rel="noopener">在<%= item.label || item.platform_name %>看</a>
      <% }) %>
      <a class="latest-episode-all" href="<%- url_for('/videos/') %>">全部期号</a>
    </div>
  </div>
</div>
<% } %>
