# Build output
/platforms/blog/site/public/
/platforms/blog/site/source/
!/platforms/blog/site/source/all/
!/platforms/blog/site/source/recommended/

# 搬走之前的位置。仓库里已经没有这两个目录了，但**别人的旧 checkout 里还有**
# （站点搬进 platforms/ 之前构建出来的产物），留着这两行是为了不让它们
# 在 `git status` 里冒出来——否则一次 `git add -A` 就把上千个 HTML 扫进仓库。
# 等旧 checkout 都清干净了，这几行可以删。
public/
/source/
!/source/all/
!/source/recommended/

# patch-theme.py 从站点的 theme-assets/ 拷进主题的自制素材（logo、头像、收款码）。
# 真身在 platforms/blog/site/theme-assets/（入库），主题里这几张是**拷贝**——
# 构建产物，不入库，否则一次 `git add -A` 就把四张图扫进仓库。
/platforms/blog/site/themes/matery/source/medias/1.jpg
/platforms/blog/site/themes/matery/source/medias/gzh.jpg
/platforms/blog/site/themes/matery/source/medias/weixin.jpg
/platforms/blog/site/themes/matery/source/medias/zhifubao.jpg

# 内容单元仓库：母稿编译出来的产物（规格 §4.2）。
# 它是**所有平台共用的那一半**——契约层与各平台 adapter 真正读的东西，
# 但它是 build product，所以不入库；CI 里现编。
/content/units/

# Dependencies
node_modules/
# Python 项目环境（类型检查与本地测试用；依赖清单在 requirements/）
.venv/

# OS
.DS_Store

# Editor
.vscode
.obsidian

# Misc
*.pdf
__pycache__/
.pytest_cache/

# Isolated git worktrees for feature work (git worktree add .worktrees/<branch>).
# Ignored so a worktree checkout is never mistaken for repository content.
.worktrees/

# Superpowers scratch: SDD ledgers, task briefs, review packages.
.superpowers/

# Agent session scratch (pi/Claude session ids) — local bookkeeping only.
session.txt

# Media assets (audio / video) — never committed, kept on local disk only.
# A single finished cut is 15~35 MB; 100 episodes would be GB-scale, and a
# binary blob in git is unreadable in every diff and review. What belongs in
# the repo is the reproducible input (scripts, storyboard contract, subtitle
# styles), not the rendered output.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.m4a
*.aac
*.flac

# Generated by localize-cdn.py in CI
tools/cdn-manifest.json

# Hexo generated index (regenerated by `hexo generate`)
db.json

# npm dependency lock (managed by release, not committed)
package-lock.json

# Draft design for a future AI content pipeline (not part of the current architecture)
dbmedia/
