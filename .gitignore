# ── 站点构建产物（hexo，2026-11-20）────────────────────────────
# hexo 的产物目录。
/platforms/blog/site/dist/
# hexo 的缓存（Astro 时代留下的 `.astro/` 也一并挡掉）。
/platforms/blog/site/db.json
/platforms/blog/site/.astro/
# 站点配置：由 `_config.template.yml` + `data/site.json` 填出来（生成物）。
/platforms/blog/site/_config.yml
# 站点源目录里的生成物：
#   _posts/   —— 内容单元编出来的文章（build-posts.py）
#   _data/    —— 模板读的数据（build-learning-path.py / apply-site-config.py）
#   images/   —— 母稿里的图片（build-posts.py）
#   lib/      —— 第三方库（copy-vendor.py）
#   learning/ —— 学习流的页面（build-learning-path.py）
#   redirects/ —— URL 级跳转页（build-posts.py，按 data/url-redirects.json 编）
#   about/    —— 关于页（apply-site-config.py）
#   docs/     —— 目录导航页（build-posts.py，kind: category 的单元）
#   robots.txt / manifest.json —— 跟着身份走的两个小文件
/platforms/blog/site/source/_posts/
/platforms/blog/site/source/_data/
/platforms/blog/site/source/docs/
/platforms/blog/site/source/images/
/platforms/blog/site/source/lib/
/platforms/blog/site/source/learning/
/platforms/blog/site/source/redirects/
/platforms/blog/site/source/about/
/platforms/blog/site/source/robots.txt
/platforms/blog/site/source/manifest.json
# 学习流的编译结果（build-learning-path.py 编出来的，跟内容单元一样是产物）
/platforms/blog/site/data/learning-path.compiled.json
# 内容单元仓库：母稿编译出来的产物（规格 §4.2）。
# 它是**所有平台共用的那一半**——契约层与各平台 adapter 真正读的东西，
# 但它是 build product，所以不入库；CI 里现编。
/content/units/

# Dependencies
node_modules/
# 创作平台前端的构建产物（vite）。
/front/dist/
# Python 项目环境（类型检查与本地测试用；依赖清单在 requirements/）
.venv/

# OS
.DS_Store

# Editor
.vscode
.obsidian

# Misc
*.pdf
__pycache__/
.pytest_cache/

# Isolated git worktrees for feature work (git worktree add .worktrees/<branch>).
# Ignored so a worktree checkout is never mistaken for repository content.
.worktrees/

# Claude Code session state: local settings and the worktrees the agent
# creates under `.claude/worktrees/`. Same reasoning as `.worktrees/` above —
# a checkout inside the repo is a **copy** of the repo, not the repo.
# Left ignored wholesale (rather than just the worktrees) so a stale copy
# never leaks into a commit or into a directory-scanning guard.
.claude/

# Superpowers scratch: SDD ledgers, task briefs, review packages.
.superpowers/

# Agent session scratch (the "remember" ledger the ECC hooks write into
# whatever directory a session happens to run in). Local bookkeeping only.
# It must be ignored **from the repo root** — a nested `.gitignore` inside
# it does not stop git from reporting the directory itself, and
# `publish/tests/test_real_declarations.py` walks `platforms/` treating every
# directory as a platform. One scratch dir under `platforms/` would fail
# that guard for a reason that has nothing to do with the code.
.remember/

# Agent session scratch (pi/Claude session ids) — local bookkeeping only.
session.txt

# Media assets (audio / video) — never committed, kept on local disk only.
# A single finished cut is 15~35 MB; 100 episodes would be GB-scale, and a
# binary blob in git is unreadable in every diff and review. What belongs in
# the repo is the reproducible input (scripts, storyboard contract, subtitle
# styles), not the rendered output.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.m4a
*.aac
*.flac

