<%#
  目录导航页 —— `/docs/<目录>/`。

  **它是什么**：内容单元里 `kind: category` 的那些（母稿是目录下的
  `_index.md`）。它不是文章，所以没有发布日期、没有字数、没有上下篇——
  它是**这一层目录的门面**：一段引言 + 底下那些文档的入口。

  **为什么单独一个 layout**：Hexo 找不到 `page.ejs` 时会退回 `post.ejs`，
  那一套带上发布日期、阅读时长、上下篇导航，对一页目录索引全是不相干的东西
  （一篇文章的「上一篇」，对「PostgreSQL 源码主线」这个目录没有任何意义）。

  **子文档从哪来**：站上所有文章与目录页的地址（`permalink`）里，落在
  本页地址底下、且**只深一层**的那些。深两层的归各自的目录页管——
  目录是分层的，不是一口气摊平。

  用 `<div>` 而不是 `<nav>` 放面包屑：Materialize 按**元素名**给 nav 上样式
  （`nav{height:64px;...}`），那一块会被压成一条 64px 高的红条。
  参见 tests/test_content_nav_not_materialize_navbar.py。
%>
<%
  // ⚠️ 这里有两个坑，少一个都表现为「目录页生成成 0 字节的空文件」——
  // Hexo 吞掉渲染错误（只记一条 ERROR），页面就静悄悄地不见了。
  //
  // 坑一：`site.posts` / `site.pages` 在 Hexo 里是 **Query**（warehouse 的
  // 查询对象），不是数组——它没有 `concat`。直接写
  // `(site.posts || []).concat(...)` 会抛 TypeError。
  //
  // 坑二：地址的形状不统一。页面自己的 `permalink` 是绝对地址且以
  // `index.html` 结尾（`https://站点/docs/x/index.html`），
  // 文章的 `permalink` 是绝对地址且以 `/` 结尾。两者直接比前缀，
  // 谁也不匹配谁——于是目录页一个子级都列不出来。
  // 所以两边都先归一化成「站内路径 + 末尾斜杠」再比。
  var _cfg = config || {};
  var _root = String(_cfg.url || '').replace(/\/+$/, '') + String(_cfg.root || '/');
  function _norm(link) {
    var s = String(link || '');
    if (_root && s.indexOf(_root) === 0) s = s.slice(_root.length);
    s = s.replace(/index\.html$/, '');
    if (s.charAt(0) !== '/') s = '/' + s;
    if (s.charAt(s.length - 1) !== '/') s = s + '/';
    return s;
  }
  var _base = _norm(page.permalink);
  // 底下可能有两种东西：文档（文章）与子目录的门面（目录页）。
  var _all = (site.posts ? site.posts.toArray() : [])
    .concat(site.pages ? site.pages.toArray() : []);
  var _children = _all.filter(function (p) {
    var link = _norm(p.permalink);
    if (link === _base || link.indexOf(_base) !== 0) return false;
    // 只取直接子级：剩下的地址里只许有一个斜杠。
    var rest = link.slice(_base.length);
    return rest.slice(0, -1).indexOf('/') === -1;
  }).map(function (p) {
    return { title: p.title, description: p.description, url: _norm(p.permalink) };
  });
%>
<main class="content learning-page">
  <div class="container learning-page__container">
    <div class="learning-page__crumb">
      <a href="<%- url_for('/') %>"><i class="fas fa-home"></i>&nbsp;首页</a>
      <span class="learning-page__crumb-sep">/</span>
      <a href="<%- url_for('/archives/') %>">归档</a>
    </div>

    <div class="card">
      <div class="card-content learning-page__body">
        <div id="articleContent">
          <%- page.content %>
        </div>

        <% if (_children.length) { %>
        <hr/>
        <h3>这一层有什么</h3>
        <ul>
          <% _children.forEach(function (p) { %>
          <li>
            <a href="<%- url_for(p.url) %>"><%= p.title %></a>
            <% if (p.description) { %>
            <div class="docs-index__desc"><%= p.description %></div>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
</main>
