<!-- 文章内容详情 -->
<div id="artDetail">
    <div class="card">
        <div class="card-content article-info">
            <%# 分类名与标签 chip 退休了 —— 分类页/标签页整套不做，
                文章页再链过去就是死链。分类信息还在 front matter 里
                （学习流归类、搜索索引都在用），只是不再往访客面前摆。 %>
            <div class="post-info">
                <% if (theme.postInfo.date) { %>
                <div class="post-date info-break-policy">
                    <i class="far fa-calendar-minus fa-fw"></i><%- __('publishDate') %>:&nbsp;&nbsp;
                    <%- date(page.date, 'YYYY-MM-DD') %>
                </div>
                <% } %>

                <% if (theme.postInfo.update) { %>
                <div class="post-date info-break-policy">
                    <i class="far fa-calendar-check fa-fw"></i><%- __('updateDate') %>:&nbsp;&nbsp;
                    <%- date(page.updated, 'YYYY-MM-DD') %>
                </div>
                <% } %>

                <% if (theme.postInfo.wordCount) { %>
                <div class="info-break-policy">
                    <i class="far fa-file-word fa-fw"></i><%- __('wordCount') %>:&nbsp;&nbsp;
                    <%= wordcount(page.content) %>
                </div>
                <% } %>

                <% if (theme.postInfo.min2read) { %>
                <div class="info-break-policy">
                    <i class="far fa-clock fa-fw"></i><%- __('readTimes') %>:&nbsp;&nbsp;
                    <%# min2read-speed-patched: cn=450/en=250 (~1.5x faster than hexo-wordcount defaults of 300/160) %>
<%= min2read(page.content, {cn: 450, en: 250}) %> <%= __('Minutes') %>
                </div>
                <% } %>

                <% if (theme.postInfo.readCount && theme.siteCounter && theme.siteCounter.enable) { %>
                    <div id="busuanzi_container_page_pv" class="info-break-policy">
                        <i class="far fa-eye fa-fw"></i><%- __('readCount') %>:&nbsp;&nbsp;
                        <span id="busuanzi_value_page_pv"></span>
                    </div>
				<% } %>
            </div>
        </div>
        <hr class="clearfix">

        <% if (theme.code.break) { %>
        <!-- 代码块折行 -->
        <style type="text/css">
            code[class*="language-"], pre[class*="language-"] { white-space: pre-wrap !important; }
        </style>
        <% } %>

        <div class="card-content article-card-content">
            <%- partial('_partial/post-tldr') %>
            <div id="articleContent">
                <%- page.content %>
            </div>
            <hr/>

            <%- partial('_partial/reprint-statement') %>

            <div class="tag_share" style="display: block;">
                <%# 标签 chip 退休了（标签页整套不做）—— 这里只剩分享。 %>
                <div class="post_share" style="zoom: 80%; width: fit-content; display: inline-block; float: right; margin: -0.15rem 0;">
                    <%- partial('_partial/share') %>
                </div>
            </div>
        </div>
    </div>

    <%- partial('_partial/post-actions') %>

    <%- partial('_partial/related-posts') %>

    <%- partial('_partial/prev-next') %>
</div>

<%- partial('_partial/codeblock') %>
