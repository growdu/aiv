---
/**
 * 站点骨架。
 *
 * 只负责三件事：顶栏、版心、页脚。页面自己往 `slot` 里塞东西。
 * 全站只有这一处引 global.css，也只有这一处挂 mermaid 的客户端渲染。
 *
 * **顶栏、页脚、标题全走 `data/site.json`**——框架层不认识任何站点，
 * 「我是谁、我在哪儿」由使用者定义（见 `src/lib/site.ts`）。
 */
import '../styles/global.css';
import { navItems, search, footerNote, siteDescription, siteName, pageTitle as titleWithSite } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** 顶栏高亮项（对应 site.json 里某个 nav 项的 key） */
  nav?: string | null;
  /** 页面自身的 class（比如文档页要占满宽度） */
  bodyClass?: string;
}

const { title, description = siteDescription, nav = null, bodyClass = '' } = Astro.props;

const pageTitle = titleWithSite(title);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={bodyClass}>
    <nav class="site-nav">
      <a class="logo" href="/">{siteName}</a>
      {navItems.map((item) => (
        <a class:list={['nav-link', { active: nav === item.key }]} href={item.href}>{item.label}</a>
      ))}
      <span class="nav-spacer"></span>
      {search && <a class="nav-link" href={search.href}>{search.label}</a>}
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div>{footerNote}</div>
        <div style="margin-top:6px">
          {navItems.map((item, i) => (
            <>
              {i > 0 && ' · '}
              <a href={item.href}>{item.label}</a>
            </>
          ))}
        </div>
      </div>
    </footer>

    <!--
      mermaid 客户端渲染。

      流程图分散在几百个页面里，单页通常只有一两张，所以按需加载：
      滚到图附近才 import mermaid 并渲染。源码留在 HTML 里，搜索引擎读得到。
    -->
    <script>
      const boot = async () => {
        const nodes = Array.from(document.querySelectorAll('div.mermaid'));
        if (nodes.length === 0) return;
        const mod = await import(/* @vite-ignore */ '/js/mermaid.esm.min.mjs');
        const mermaid = mod.default;
        mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });
        const render = async (node) => {
          if (node.dataset.rendered) return;
          node.dataset.rendered = '1';
          try {
            const { svg } = await mermaid.render('m' + Math.random().toString(36).slice(2), node.textContent);
            node.innerHTML = svg;
          } catch (err) {
            // 渲染失败不阻断页面：div 里留着源码，页面上就是一段文本。
            node.classList.add('mermaid-failed');
          }
        };
        if (!('IntersectionObserver' in window)) {
          for (const node of nodes) render(node);
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              io.unobserve(entry.target);
              render(entry.target);
            }
          }
        }, { rootMargin: '300px' });
        for (const node of nodes) io.observe(node);
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>
