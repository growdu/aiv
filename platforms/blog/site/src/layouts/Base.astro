---
/**
 * 站点骨架。
 *
 * 只负责三件事：顶栏、版心、页脚。页面自己往 `slot` 里塞东西。
 * 全站只有这一处引 global.css，也只有这一处挂 mermaid 的客户端渲染。
 */
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 顶栏高亮项 */
  nav?: 'learning' | 'videos' | 'all' | 'about' | 'timeline' | null;
  /** 页面自身的 class（比如文档页要占满宽度） */
  bodyClass?: string;
}

const { title, description = 'growdu：一条成体系的学习流。数据库内核、分布式、网络与数据面、AI 工具与工程实践。', nav = null, bodyClass = '' } = Astro.props;

const navItems = [
  { key: 'learning', href: '/learning/', label: '学习流' },
  { key: 'videos', href: '/videos/', label: '视频' },
  { key: 'all', href: '/all/', label: '全部' },
  { key: 'timeline', href: '/timeline/', label: '时间轴' },
  { key: 'about', href: '/about/', label: '关于' },
];

const pageTitle = title === 'growdu' ? title : `${title} · growdu`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={bodyClass}>
    <nav class="site-nav">
      <a class="logo" href="/">growdu</a>
      {navItems.map((item) => (
        <a class:list={['nav-link', { active: nav === item.key }]} href={item.href}>{item.label}</a>
      ))}
      <span class="nav-spacer"></span>
      <a class="nav-link" href="/all/">全库检索</a>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div>growdu · 一个人的学习流。文档与视频都由这个仓库生成。</div>
        <div style="margin-top:6px">
          <a href="/learning/">学习流</a> ·
          <a href="/videos/">视频</a> ·
          <a href="/all/">全部</a> ·
          <a href="/timeline/">时间轴</a> ·
          <a href="/about/">关于</a>
        </div>
      </div>
    </footer>

    <!--
      mermaid 客户端渲染。

      流程图分散在几百个页面里，单页通常只有一两张，所以按需加载：
      滚到图附近才 import mermaid 并渲染。源码留在 HTML 里，搜索引擎读得到。
    -->
    <script>
      const boot = async () => {
        const nodes = Array.from(document.querySelectorAll('div.mermaid'));
        if (nodes.length === 0) return;
        const mod = await import(/* @vite-ignore */ '/js/mermaid.esm.min.mjs');
        const mermaid = mod.default;
        mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });
        const render = async (node) => {
          if (node.dataset.rendered) return;
          node.dataset.rendered = '1';
          try {
            const { svg } = await mermaid.render('m' + Math.random().toString(36).slice(2), node.textContent);
            node.innerHTML = svg;
          } catch (err) {
            // 渲染失败不阻断页面：div 里留着源码，页面上就是一段文本。
            node.classList.add('mermaid-failed');
          }
        };
        if (!('IntersectionObserver' in window)) {
          for (const node of nodes) render(node);
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              io.unobserve(entry.target);
              render(entry.target);
            }
          }
        }, { rootMargin: '300px' });
        for (const node of nodes) io.observe(node);
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    </script>
  </body>
</html>
