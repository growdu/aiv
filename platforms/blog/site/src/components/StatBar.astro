---
/**
 * 那一条数字：连续写了多少天、偷懒多少天、学了多少天、用了多少 AI。
 *
 * 数据来自 `data/activity.compiled.json`（账本 + 内容单元编译出来的）。
 *
 * **大数永远是「连着多少天」，小字才是累计。** 四张卡一个规矩：
 * 连续写作 / 连续学习 / 连续用 AI 是连着干了多少天；
 * 连续偷懒是连着多少天没动静——它跟上面三个互为反面，
 * 用同一个尺子才看得出今天的状态。
 *
 * 口径写在 `data/activity.json` 的 `rules` 里，页面上只负责摆。
 */
import { stats, sinceOutput } from '../lib/activity';

const slackHint =
  sinceOutput !== null ? `累计 ${stats.slack.total} 天` : '还没产出过';

const cards = [
  { big: stats.write.streak, label: '连续写作', hint: `累计 ${stats.write.total} 天` },
  { big: stats.slack.streak, label: '连续偷懒', hint: slackHint },
  { big: stats.learn.streak, label: '连续学习', hint: `累计 ${stats.learn.total} 天` },
  { big: stats.ai.streak, label: '连续用 AI', hint: `累计 ${stats.ai.total} 天` },
];
---

<div class="stat-bar">
  {cards.map((card) => (
    <div class="stat-card">
      <div class="stat-num">{card.big}<span class="stat-unit">天</span></div>
      <div class="stat-label">{card.label}</div>
      <div class="stat-hint">{card.hint}</div>
    </div>
  ))}
  <a class="stat-more" href="/timeline/">看看时间轴 →</a>
</div>

<style>
  .stat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 10px;
    margin: 4px 0 0;
  }

  .stat-card {
    flex: 1 1 130px;
    min-width: 120px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .stat-num {
    color: var(--ink);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .stat-unit {
    margin-left: 3px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .stat-label {
    margin-top: 2px;
    color: var(--body);
    font-size: 13.5px;
    font-weight: 600;
  }

  .stat-hint {
    color: var(--faint);
    font-size: 12.5px;
  }

  .stat-more {
    display: flex;
    align-items: center;
    padding: 0 4px;
    color: var(--brand);
    font-size: 13.5px;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .stat-num {
      font-size: 24px;
    }
  }
</style>
