---
/**
 * 首页赛道卡片：赛道名 + 一句话定位 + 阶梯缩略图。
 *
 * 缩略图是这个卡片的主角——一条赛道有哪几级、哪几级已经有内容，
 * 一眼看到。灰色的格子是「还没审校到」的阶段。
 */
import { trackUrl } from '../lib/urls';
import type { Track } from '../lib/learning';

interface Props {
  track: Track;
  /** 阶梯里有没有视频（视频格子用琥珀黄） */
  videoStages?: string[];
}

const { track, videoStages = [] } = Astro.props;
const filled = new Set<string>();
for (const stage of track.stages) {
  if (stage.count > 0) filled.add(stage.id);
}
---

<a class="track-card" href={trackUrl(track.id)}>
  <h3>{track.title}</h3>
  <p>{track.summary}</p>
  <div class="steps" aria-hidden="true">
    {track.stages.map((stage) => (
      <i class:list={{ on: filled.has(stage.id), vid: videoStages.includes(stage.id) && filled.has(stage.id) }}></i>
    ))}
  </div>
  <div class="track-meta small muted">
    {track.count} 篇 · {track.stages.length} 个阶段
  </div>
</a>

<style>
  .track-card {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 16px 12px;
    background: #fff;
    color: inherit;
  }

  .track-card:hover {
    border-color: var(--brand);
    text-decoration: none;
    box-shadow: 0 1px 6px rgba(43, 76, 126, 0.08);
  }

  .track-card h3 {
    margin: 0 0 4px;
    font-size: 17px;
    color: var(--ink);
  }

  .track-card p {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
    min-height: 2.6em;
  }

  .track-meta {
    margin-top: 8px;
  }
</style>
