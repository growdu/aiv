---
/**
 * 一条赛道的阶梯。
 *
 * 每个阶段一格：从上往下是 L1→L8，**空的阶段也画出来**（灰的），
 * 因为「这条线还没写到哪」本身就是信息——它告诉读者缺什么。
 */
import { unitUrl, stageUrl } from '../lib/urls';
import type { Track } from '../lib/learning';
import type { Unit } from '../lib/units';

interface Props {
  track: Track;
  unitsById: Map<string, Unit>;
  /** 当前高亮的阶段 */
  currentStage?: string;
  /** 空的阶段要不要显示 */
  showEmpty?: boolean;
}

const { track, unitsById, currentStage = '', showEmpty = true } = Astro.props;
---

<div class="ladder">
  {track.stages.map((stage) => {
    const empty = stage.count === 0;
    if (empty && !showEmpty) return null;
    return (
      <div class:list={['rung', { empty, cur: currentStage === stage.id }]}>
        <div class="rung-head">
          <span class="lv">{stage.id}</span>
          <span class="rung-title">{stage.title}</span>
          <span class="nav-spacer"></span>
          {stage.count > 0 && <span class="small muted">{stage.count} 篇</span>}
        </div>
        <p class="rung-goal">{stage.goal}</p>
        {stage.count > 0 ? (
          <ul>
            {stage.units.map((id) => {
              const unit = unitsById.get(id);
              if (!unit) return null;
              return (
                <li>
                  <a href={unitUrl(id, unit.data.kind)}>
                    {unit.data.kind === 'video' && <span class="badge vid">视频</span>}
                    {unit.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="rung-goal small">这一阶段还没有过审的内容。</p>
        )}
        <p class="next">
          <a href={stageUrl(track.id, stage.id)}>进入这个阶段 →</a>
        </p>
      </div>
    );
  })}
</div>

<style>
  .rung.cur {
    border-left-color: var(--accent);
    background: var(--accent-soft);
  }

  .rung .nav-spacer {
    flex: 1;
  }

  .rung li a {
    color: var(--body);
  }

  .rung li a:hover {
    color: var(--brand);
  }
</style>
