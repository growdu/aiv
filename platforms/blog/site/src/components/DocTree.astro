---
/**
 * 左栏：docs/ 的目录树。
 *
 * **树 = docs/ 的真实结构**，一比一（`lib/tree.ts` 从内容单元的 id 切出来）：
 * 一级目录就是分类，`_index.md` 是那个目录的落地页，其余 .md 是文章。
 * 站点不在这里发明分类——分类只存在于目录里。
 *
 * 学习流折在树上：阶段本来就是目录（`…/getting-started/` 就是 L1），
 * 所以节点上挂阶段标记，不再单占一栏。
 *
 * 视频是另一条流水线的东西（video/ 不在 docs/ 里），单独一根。
 */
import { buildTree, attachStages } from '../lib/tree';
import { assignmentOf, getTrack } from '../lib/learning';
import type { Unit } from '../lib/units';
import TreeItem, { type StageInfo } from './TreeItem.astro';

interface Props {
  units: Unit[];
  currentId: string;
}

const { units, currentId } = Astro.props;

/** 内容单元 id → 阶段标记（阶段 id + 「赛道 · 阶段名」提示）。 */
const stageInfo = new Map<string, StageInfo>();
/** 阶段 id → 「赛道 · 阶段名」（目录节点挂的是阶段的提示，不是某个单元的）。 */
const stageText = new Map<string, string>();
for (const unit of units) {
  const assignment = assignmentOf(unit.id);
  if (!assignment) continue;
  const track = getTrack(assignment.track);
  const stage = track?.stages.find((s) => s.id === assignment.stage);
  if (!stage) continue;
  const text = `${track?.title ?? assignment.track} · ${stage.id} ${stage.title}`;
  stageInfo.set(unit.id, { id: stage.id, text });
  if (!stageText.has(stage.id)) stageText.set(stage.id, text);
}

const tree = buildTree(units, currentId);
attachStages(tree, (id) => stageInfo.get(id)?.id);
---

<nav class="tree" aria-label="目录树">
  <div class="tree-root">docs/</div>
  <ul class="tree-list">
    {tree.docs.map((node) => (
      <li>
        <TreeItem node={node} stageInfo={stageInfo} stageText={stageText} />
      </li>
    ))}
  </ul>

  {tree.video && (
    <>
      <div class="tree-root">video/</div>
      <ul class="tree-list">
        <li>
          <TreeItem node={tree.video} stageInfo={stageInfo} stageText={stageText} />
        </li>
      </ul>
    </>
  )}
</nav>
