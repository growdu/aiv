---
/**
 * 时间轴：按月排开，每天一格；写了东西的日子把东西挂在下面。
 *
 * 数据来自 `data/activity.compiled.json`——编译自站点的账本与
 * `docs/` 编译出来的内容单元。**站点只知道自己账本里的日子**，
 * 所以「没动静」的那几天是真的空着，不补。
 */
import { months, shortDate, type ActivityDay } from '../lib/activity';

const groups = months();

/** 当天写了几篇 → 格子深浅（0~3）。 */
function level(day: ActivityDay): number {
  if (!day.write) return 0;
  if (day.n >= 3) return 3;
  if (day.n === 2) return 2;
  return 1;
}

function titleOf(day: ActivityDay): string {
  const bits: string[] = [];
  if (day.write) bits.push(`写了 ${day.n} 篇`);
  if (day.learn) bits.push('学习');
  if (day.ai && !day.write) bits.push('用了 AI');
  if (!bits.length) bits.push('没动静');
  if (day.note) bits.push(day.note);
  return `${day.date}：${bits.join(' · ')}`;
}
---

<div class="timeline">
  {groups.map((group) => (
    <section class="tl-month">
      <header class="tl-head">
        <h3>{group.label}</h3>
        <span class="tl-sum">
          {group.wrote > 0 ? `写了 ${group.wrote} 天 · ${group.docs} 篇` : '没写东西'}
          {group.slack > 0 ? ` · 停了 ${group.slack} 天` : ''}
        </span>
      </header>

      {group.wrote > 0 || group.days.some((day) => day.ai) ? (
        <>
          <div class="tl-strip">
            {group.days.map((day) => (
              <span
                class:list={['tl-cell', `lv${level(day)}`, { ai: day.ai && !day.write }]}
                title={titleOf(day)}
              />
            ))}
          </div>

          <ul class="tl-days">
            {group.days.filter((day) => day.write || day.ai).map((day) => (
              <li class="tl-day">
                <span class="tl-date">{shortDate(day.date)}</span>
                <span class="tl-body">
                  {day.docs.length > 0 && (
                    <span class="tl-docs">
                      {day.docs.map((doc) => (
                        <a class="tl-doc" href={doc.url}>
                          {doc.kind === 'video' && <span class="tl-kind">视频</span>}
                          {doc.title}
                        </a>
                      ))}
                    </span>
                  )}
                  {!day.write && day.ai && <span class="tl-note">用了 AI，没写稿</span>}
                  {day.note && <span class="tl-note">{day.note}</span>}
                </span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        /* 整月没动静：不画格子，一行带过——那才是「偷懒」该有的分量，
           铺一整排空格只会把页面撑长。 */
        <p class="tl-quiet">这个月没动静，停了 {group.slack} 天。</p>
      )}
    </section>
  ))}
</div>

<style>
  .timeline {
    margin-top: 4px;
  }

  .tl-month {
    padding: 14px 0;
    border-top: 1px solid var(--line-soft);
  }

  .tl-month:first-child {
    border-top: none;
  }

  .tl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .tl-head h3 {
    margin: 0;
    font-size: 16px;
  }

  .tl-sum {
    color: var(--faint);
    font-size: 12.5px;
    white-space: nowrap;
  }

  /* 一天的格子。浅→深 = 写得越多。 */
  .tl-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin: 8px 0 4px;
  }

  .tl-cell {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
  }

  .tl-cell.lv1 {
    background: #cfdcec;
    border-color: #cfdcec;
  }

  .tl-cell.lv2 {
    background: #8fabd0;
    border-color: #8fabd0;
  }

  .tl-cell.lv3 {
    background: var(--brand);
    border-color: var(--brand);
  }

  /* 用了 AI 但没写稿：琥珀色描边，跟「写了」区分开。 */
  .tl-cell.ai {
    background: var(--accent-soft);
    border-color: var(--accent-line);
  }

  .tl-days {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }

  .tl-day {
    display: flex;
    gap: 10px;
    padding: 4px 0;
    border-bottom: 1px dashed var(--line-soft);
  }

  .tl-day:last-child {
    border-bottom: none;
  }

  .tl-date {
    flex: 0 0 46px;
    color: var(--faint);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  .tl-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-docs {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-doc {
    color: var(--body);
    font-size: 14px;
  }

  .tl-doc:hover {
    color: var(--brand);
  }

  .tl-kind {
    margin-right: 5px;
    padding: 0 5px;
    border: 1px solid var(--accent-line);
    border-radius: 3px;
    background: var(--accent-soft);
    color: #a86f12;
    font-size: 11px;
    vertical-align: 1px;
  }

  .tl-note {
    color: var(--muted);
    font-size: 12.5px;
  }

  .tl-quiet {
    margin: 4px 0 0;
    color: var(--faint);
    font-size: 12.5px;
  }
</style>
