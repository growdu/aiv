---
/**
 * 右栏：文章大纲 + 元信息。
 *
 * 大纲来自 Astro 渲染时给出的 headings（slug 与正文里的锚点一致，
 * 所以点一下就跳到那一节）。
 *
 * 下面接一块元信息（分类 / 标签 / 日期 / 来源路径）——
 * 树给出「它在哪」，大纲给出「这篇讲什么」，元信息补上「它是什么」。
 */
import type { MarkdownHeading } from 'astro';
import type { Unit } from '../lib/units';

interface Props {
  headings: MarkdownHeading[];
  unit: Unit;
}

const { headings, unit } = Astro.props;

/** 缩进按「本文最小的标题层级」起算，别让 h2 和 h4 差三格。 */
const baseDepth = headings.length > 0 ? Math.min(...headings.map((h) => h.depth)) : 2;

const dateText =
  typeof unit.data.date === 'string'
    ? unit.data.date
    : unit.data.date.toISOString().slice(0, 10);

/** 标签常常就是分类名，别把同一串词显示两遍。 */
const extraTags = unit.data.tags.filter((t) => !unit.data.categories.includes(t));
---

<aside class="side side-outline">
  <div class="side-group">
    <h4>大纲</h4>
    {headings.length > 0 ? (
      <ul class="outline-list">
        {headings.map((h) => (
          <li class={`outline-item outline-l${h.depth - baseDepth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="side-item muted">这一篇没有小标题。</div>
    )}
  </div>

  <div class="side-group">
    <h4>元信息</h4>
    {unit.data.categories.length > 0 && (
      <div class="side-item">
        {unit.data.categories.map((c) => <span class="side-tag">{c}</span>)}
      </div>
    )}
    {extraTags.length > 0 && (
      <div class="side-item">
        {extraTags.map((t) => <span class="badge" style="margin-right:4px">{t}</span>)}
      </div>
    )}
    <div class="side-item">{dateText}</div>
    {unit.data.author && <div class="side-item muted">作者 {unit.data.author}</div>}
    <div class="side-item muted small">
      源文件 <code>{unit.data.source_path ?? unit.id}</code>
    </div>
  </div>
</aside>
