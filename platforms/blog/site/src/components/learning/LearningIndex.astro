---
/**
 * 学习流总览。
 *
 * 一张矩阵：行是赛道，列是阶段。格子里有数字就是这一级已经有内容，
 * 空白就是还没到。这张表是整个站点的「进度条」。
 *
 * 纯展示组件——数据来自 `lib/learning`（编译结果），页面自己决定要不要它。
 */
import { tracks } from '../../lib/learning';
import { stageUrl, trackUrl } from '../../lib/urls';

const stageIds = Array.from(
  new Set(tracks.flatMap((t) => t.stages.map((s) => s.id))),
).sort((a, b) => Number(a.slice(1)) - Number(b.slice(1)));

/** 阶段标题：拿哪条赛道里的那个阶段，就得是那条赛道的标题。 */
const stageTitle = new Map<string, string>();
for (const track of tracks) {
  for (const stage of track.stages) stageTitle.set(`${track.id}/${stage.id}`, stage.title);
}

/** 某一列（阶段 id）属于哪条赛道——列头要写对名字。 */
const stageOwner = new Map<string, string>();
for (const track of tracks) {
  for (const stage of track.stages) if (!stageOwner.has(stage.id)) stageOwner.set(stage.id, track.id);
}
---

<div class="wrap">
  <section class="section">
    <h2>学习流</h2>
    <p class="section-sub">
      {tracks.length} 条赛道，每条是一串从入门到深入的阶段。格子里是这一级已经过审的内容数。
    </p>
  </section>

  <div class="matrix-scroll">
    <table class="matrix">
      <thead>
        <tr>
          <th class="track-col">赛道</th>
          {stageIds.map((id) => (
            <th title={stageTitle.get(`${stageOwner.get(id)}/${id}`) ?? id}>{id}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {tracks.map((track) => (
          <tr>
            <td class="track">
              <a href={trackUrl(track.id)}>{track.title}</a>
              <span class="muted small"> · {track.count}</span>
            </td>
            {stageIds.map((id) => {
              const stage = track.stages.find((s) => s.id === id);
              if (!stage) return <td class="muted">—</td>;
              if (stage.count === 0) {
                return (
                  <td>
                    <a class="muted" href={stageUrl(track.id, stage.id)} title={stage.title}>·</a>
                  </td>
                );
              }
              return (
                <td class="filled">
                  <a href={stageUrl(track.id, stage.id)}>{stage.count}</a>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="section">
    {tracks.map((track) => (
      <div class="track-block">
        <h3><a href={trackUrl(track.id)}>{track.title}</a></h3>
        <p class="muted small">{track.summary}</p>
        <details class="fold">
          <summary>这条路走到哪儿了</summary>
          <div class="fold-body">
            <p><b>给谁看：</b>{track.audience}</p>
            <p><b>走完能干什么：</b>{track.goal}</p>
            <ul>
              {track.stages.map((stage) => (
                <li>
                  <a href={stageUrl(track.id, stage.id)}>{stage.id} {stage.title}</a>
                  <span class="muted"> — {stage.count} 篇</span>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    ))}
  </section>
</div>

<style>
  .matrix-scroll {
    overflow-x: auto;
  }

  .track-col {
    text-align: left;
    white-space: nowrap;
  }

  .track-block {
    margin: 0 0 18px;
  }

  .track-block h3 {
    margin: 0 0 2px;
    font-size: 17px;
  }
</style>
