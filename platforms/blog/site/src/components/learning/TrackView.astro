---
/**
 * 赛道页：一条线走完是什么样。
 *
 * 顶上是这条路给谁看、走完能干什么；下面是从第一级到最后一级的阶梯，
 * **空的阶段也画出来**——缺什么也是内容的一部分。
 */
import StageLadder from '../StageLadder.astro';
import { allUnits } from '../../lib/units';
import type { Track } from '../../lib/learning';

interface Props {
  track: Track;
}

const { track } = Astro.props;
const units = await allUnits();
const unitsById = new Map(units.map((u) => [u.id, u]));
---

<div class="wrap">
  <section class="section">
    <h1 class="track-title">{track.title}</h1>
    <p class="track-summary">{track.summary}</p>

    <div class="track-facts">
      <div class="fact">
        <div class="label">给谁看</div>
        <p>{track.audience}</p>
      </div>
      <div class="fact">
        <div class="label">走完能干什么</div>
        <p>{track.goal}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>阶梯</h2>
    <p class="section-sub">{track.count} 篇内容，{track.stages.length} 个阶段。</p>
    <StageLadder track={track} unitsById={unitsById} />
  </section>
</div>

<style>
  .track-title {
    margin: 6px 0 4px;
    font-size: 28px;
  }

  .track-summary {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 16px;
  }

  .track-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .fact {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 14px;
    background: var(--panel);
  }

  .fact p {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--body);
  }

  @media (max-width: 760px) {
    .track-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
