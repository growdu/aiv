---
/**
 * 全库：按分类（一级目录）分组的所有内容。
 *
 * 这里的分组是**目录坐标**——按仓库目录树的一级目录分。
 * 学习流的分组在 /learning/。两个坐标都留着，因为它们回答不同的问题。
 */
import Base from '../../layouts/Base.astro';
import UnitRow from '../../components/UnitRow.astro';
import { allUnits } from '../../lib/units';
import { tracks } from '../../lib/learning';
import { siteName } from '../../lib/site';

const units = await allUnits();
const items = units.filter((u) => u.data.kind !== 'category');

const groups = new Map<string, typeof items>();
for (const unit of items) {
  const key = unit.data.categories[0] ?? '未分类';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(unit);
}

const sorted = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh'));
---

<Base title="全部内容" nav="all" description={`${siteName} 的全部文档与视频，按分类列出。`}>
  <div class="wrap">
    <section class="section">
      <h2>全部内容</h2>
      <p class="section-sub">
        {items.length} 篇。分组按仓库目录树的一级目录；
        {tracks.length > 0 && <>按学习流分组请去 <a href="/learning/">学习流</a>。</>}
      </p>
      <input
        type="search"
        id="filter"
        placeholder="按标题筛选…"
        autocomplete="off"
        aria-label="按标题筛选"
      />
    </section>

    {sorted.map(([name, list]) => (
      <section class="group">
        <h3 class="group-name">{name}</h3>
        <ul class="unit-list">
          {list.map((unit) => (
            <li data-title={unit.data.title.toLowerCase()}>
              <UnitRow unit={unit} />
            </li>
          ))}
        </ul>
        <p class="empty-hint muted small" hidden>这一组没有匹配的内容。</p>
      </section>
    ))}
  </div>
</Base>

<script>
  const input = document.getElementById('filter') as HTMLInputElement | null;
  if (input) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const group of document.querySelectorAll<HTMLElement>('.group')) {
        let visible = 0;
        for (const li of group.querySelectorAll<HTMLElement>('li[data-title]')) {
          const hit = !q || (li.dataset.title ?? '').includes(q);
          li.hidden = !hit;
          if (hit) visible++;
        }
        const hint = group.querySelector<HTMLElement>('.empty-hint');
        if (hint) hint.hidden = visible > 0;
        group.hidden = visible === 0;
      }
    });
  }
</script>

<style>
  #filter {
    width: 100%;
    max-width: 360px;
    padding: 7px 11px;
    font-size: 14px;
    font-family: var(--font-sans);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }

  .group {
    margin: 0 0 22px;
  }

  .group-name {
    margin: 0 0 4px;
    font-size: 16px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line);
  }

  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
