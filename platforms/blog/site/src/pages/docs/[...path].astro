---
/**
 * 文档页 / 目录页。
 *
 * 同一个路由两种内容：
 *   kind=document → 一篇文章
 *   kind=category → 一个目录（列出它下面的文档与子目录）
 *
 * 三栏：左栏是**目录树**（docs/ 的真实结构），中间是正文，
 * 右栏是**文章大纲**（这篇的小标题）。
 *
 * 学习流不单独占栏——阶段本来就是目录（`…/getting-started/` 就是 L1），
 * 所以它折在树上（节点上的 L1 / L2 标记）。
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocTree from '../../components/DocTree.astro';
import Outline from '../../components/Outline.astro';
import UnitRow from '../../components/UnitRow.astro';
import { allUnits, categoryPath, isCategoryId } from '../../lib/units';

export async function getStaticPaths() {
  const units = await allUnits();
  return units
    .filter((u) => u.data.kind === 'document' || u.data.kind === 'category')
    .map((unit) => ({
      params: { path: isCategoryId(unit.id) ? categoryPath(unit.id) : unit.id },
      props: { unit, units },
    }));
}

const { unit } = Astro.props;
const { Content, headings } = await render(unit);

const units = await allUnits();
const isCategory = unit.data.kind === 'category';
const dir = categoryPath(unit.id);

// 目录页：列出直接子文档与子目录
const children = isCategory
  ? units.filter((u) => {
      if (!u.id.startsWith(dir + '/')) return false;
      const rest = u.id.slice(dir.length + 1);
      if (rest.includes('/')) {
        // 深层：只看是不是子目录页
        return rest.endsWith('/_index');
      }
      return u.data.kind === 'document';
    })
  : [];

---

<Base
  title={unit.data.title}
  description={unit.data.description ?? ''}
  bodyClass="article-page"
>
  <div class="wrap">
    <div class="crumbs">
      <a href="/">growdu</a> / <a href="/all/">全部</a>
      {unit.data.categories.length > 0 && <span> / {unit.data.categories.join(' / ')}</span>}
    </div>

    <div class="doc-layout">
      <aside class="side">
        <DocTree units={units} currentId={unit.id} />
      </aside>

      <main>
        {isCategory ? (
          <div class="prose">
            <h1>{unit.data.title}</h1>
          </div>
        ) : (
          <>
            <div class="prose">
              <h1>{unit.data.title}</h1>
            </div>
            {unit.data.description && (
              <div class="prose">
                <div class="tldr"><b>TL;DR</b>{unit.data.description}</div>
              </div>
            )}
            <article class="prose">
              <Content />
            </article>
          </>
        )}

        {isCategory && children.length > 0 && (
          <div class="prose">
            <h2>这个目录下面</h2>
            <ul class="unit-list">
              {children.map((child) => (
                <UnitRow unit={child} />
              ))}
            </ul>
          </div>
        )}
      </main>

      <Outline headings={headings} unit={unit} />
    </div>
  </div>
</Base>

<style>
  .doc-layout {
    margin-top: 6px;
  }

  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
