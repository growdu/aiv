---
/**
 * 文档页 / 目录页。
 *
 * 同一个路由两种内容：
 *   kind=document → 一篇文章
 *   kind=category → 一个目录（列出它下面的文档与子目录）
 *
 * 三栏：左栏是**学习流坐标**（人在流程里的位置），中间是正文，
 * 右栏是**目录坐标**（这篇在仓库目录树里的位置）。两套坐标同时在场。
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TrackSide from '../../components/TrackSide.astro';
import UnitRow from '../../components/UnitRow.astro';
import { allUnits, categoryPath, isCategoryId } from '../../lib/units';
import { assignmentOf, getTrack } from '../../lib/learning';
import { unitUrl } from '../../lib/urls';

export async function getStaticPaths() {
  const units = await allUnits();
  return units
    .filter((u) => u.data.kind === 'document' || u.data.kind === 'category')
    .map((unit) => ({
      params: { path: isCategoryId(unit.id) ? categoryPath(unit.id) : unit.id },
      props: { unit, units },
    }));
}

const { unit } = Astro.props;
const { Content } = await render(unit);

const units = await allUnits();
const byId = new Map(units.map((u) => [u.id, u]));

const isCategory = unit.data.kind === 'category';
const dir = categoryPath(unit.id);

// 目录页：列出直接子文档与子目录
const children = isCategory
  ? units.filter((u) => {
      if (!u.id.startsWith(dir + '/')) return false;
      const rest = u.id.slice(dir.length + 1);
      if (rest.includes('/')) {
        // 深层：只看是不是子目录页
        return rest.endsWith('/_index');
      }
      return u.data.kind === 'document';
    })
  : [];

const assignment = assignmentOf(unit.id);
const track = assignment ? getTrack(assignment.track) : undefined;
const stage = track && assignment ? track.stages.find((s) => s.id === assignment.stage) : undefined;

const dateText = typeof unit.data.date === 'string' ? unit.data.date : unit.data.date.toISOString().slice(0, 10);
---

<Base
  title={unit.data.title}
  description={unit.data.description ?? ''}
  bodyClass="article-page"
>
  <div class="wrap">
    <div class="crumbs">
      <a href="/">growdu</a> / <a href="/all/">全部</a>
      {unit.data.categories.length > 0 && <span> / {unit.data.categories.join(' / ')}</span>}
    </div>

    <div class:list={['doc-layout', { 'no-left': !track }]}>
      {track && assignment && (
        <aside class="side">
          <TrackSide track={track} stageId={assignment.stage} unitsById={byId} currentUnitId={unit.id} />
        </aside>
      )}

      <main>
        {isCategory ? (
          <div class="prose">
            <h1>{unit.data.title}</h1>
          </div>
        ) : (
          <>
            <div class="prose">
              <h1>{unit.data.title}</h1>
            </div>
            {unit.data.description && (
              <div class="prose">
                <div class="tldr"><b>TL;DR</b>{unit.data.description}</div>
              </div>
            )}
            <article class="prose">
              <Content />
            </article>
          </>
        )}

        {isCategory && children.length > 0 && (
          <div class="prose">
            <h2>这个目录下面</h2>
            <ul class="unit-list">
              {children.map((child) => (
                <UnitRow unit={child} />
              ))}
            </ul>
          </div>
        )}
      </main>

      <aside class="side">
        <div class="side-group">
          <h4>目录位置</h4>
          <div class="side-item"><code>{unit.data.source_path ?? unit.id}</code></div>
          <div class="side-item muted small">这是它在仓库目录树里的真实位置</div>
        </div>

        {track && assignment && (
          <div class="side-group">
            <h4>学习流位置</h4>
            <div class="side-item">
              <a href={`/learning/${track.id}/`}>{track.title}</a> · {assignment.stage} {stage?.title}
            </div>
          </div>
        )}

        {unit.data.categories.length > 0 && (
          <div class="side-group">
            <h4>分类</h4>
            {unit.data.categories.map((c) => (
              <div class="side-item">{c}</div>
            ))}
          </div>
        )}

        {unit.data.tags.length > 0 && (
          <div class="side-group">
            <h4>标签</h4>
            <div class="side-item">
              {unit.data.tags.map((t) => <span class="badge" style="margin-right:4px">{t}</span>)}
            </div>
          </div>
        )}

        <div class="side-group">
          <h4>元信息</h4>
          <div class="side-item">{dateText}</div>
          {unit.data.author && <div class="side-item muted">作者 {unit.data.author}</div>}
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .doc-layout {
    margin-top: 6px;
  }

  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    padding: 0.1em 0.3em;
    overflow-wrap: anywhere;
  }
</style>
