---
/**
 * 首页：一条学习流的门面。
 *
 * 首屏只回答两个问题：这里在讲什么、从哪儿开始。
 * 下面才是赛道地图（哪条线走到哪儿了）和最近更新。
 */
import Base from '../layouts/Base.astro';
import TrackCard from '../components/TrackCard.astro';
import UnitRow from '../components/UnitRow.astro';
import { allUnits } from '../lib/units';
import { tracksWithContent, emptyTracks, tracks } from '../lib/learning';
import { unitUrl } from '../lib/urls';

const units = await allUnits();
const byId = new Map(units.map((u) => [u.id, u]));
const filled = tracksWithContent();
const empty = emptyTracks();

/** 哪些阶段的阶梯里有视频（首页缩略图用琥珀黄标出来）。 */
const videoStages = new Map<string, string[]>();
for (const track of tracks) {
  const ids: string[] = [];
  for (const stage of track.stages) {
    if (stage.units.some((id) => byId.get(id)?.data.kind === 'video')) ids.push(stage.id);
  }
  videoStages.set(track.id, ids);
}

const recent = units.filter((u) => u.data.kind !== 'category').slice(0, 6);
---

<Base title="growdu">
  <div class="wrap">
    <section class="hero">
      <div class="hero-text">
        <h1>growdu · 一条成体系的学习流</h1>
        <p>不是一堆文章，是一条能走完的路：从「会用」到「读得懂、还改得动」。</p>
        <p>每一篇文档、每一期视频都挂在同一条阶梯上，标明自己在第几级。</p>
        <div class="hero-actions">
          <a class="btn" href="/learning/">从学习流开始</a>
          <a class="btn ghost" href="/all/">直接翻全部内容</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>赛道地图</h2>
      <p class="section-sub">灰色格子是还没审校到的阶段——它标着这条线缺什么。</p>
      <div class="grid cols-3">
        {filled.map((track) => (
          <TrackCard track={track} videoStages={videoStages.get(track.id)} />
        ))}
      </div>
    </section>

    <section class="section">
      <h2>最近更新</h2>
      <p class="section-sub">新写出来、过完审校的内容。</p>
      <ul class="unit-list">
        {recent.map((unit) => (
          <UnitRow unit={unit} />
        ))}
      </ul>
      <p style="margin-top:14px"><a href="/all/">看全部 →</a></p>
    </section>

    {empty.length > 0 && (
      <section class="section">
        <details class="fold">
          <summary>规划中的赛道（{empty.length} 条）</summary>
          <div class="fold-body">
            <p>这些赛道已经定好了阶段，但内容还没写出来或没过审。放在这儿是为了让地图完整。</p>
            <ul>
              {empty.map((track) => (
                <li>
                  <a href={`/learning/${track.id}/`}>{track.title}</a>
                  <span class="muted"> — {track.summary}</span>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </section>
    )}
  </div>
</Base>

<style>
  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
