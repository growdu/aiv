---
/**
 * 视频页签：所有视频挂在学习流的同一张阶梯上。
 *
 * 视频不是站点的另一条腿，是同一条路的另一种讲法——所以这里也按赛道/阶段分组。
 */
import Base from '../../layouts/Base.astro';
import UnitRow from '../../components/UnitRow.astro';
import { allUnits } from '../../lib/units';
import { tracks } from '../../lib/learning';
import { isPlaceholder } from '../../lib/placeholders';
import { siteName } from '../../lib/site';

const units = await allUnits();
const byId = new Map(units.map((u) => [u.id, u]));
const videos = units.filter((u) => u.data.kind === 'video');
const placeholderCount = videos.filter((u) => isPlaceholder(u.id)).length;

const groups = tracks
  .map((track) => ({
    track,
    stages: track.stages
      .map((stage) => ({ stage, units: stage.units.map((id) => byId.get(id)).filter((u) => u?.data.kind === 'video') }))
      .filter((g) => g.units.length > 0),
  }))
  .filter((g) => g.stages.length > 0);
---

<Base title="视频" nav="videos" description={`${siteName} 的视频。`}>
  <div class="wrap">
    <section class="section">
      <h2>视频</h2>
      <p class="section-sub">
        {videos.length} 期。
        {tracks.length > 0
          ? '视频挂在学习流的同一张阶梯上——它们是同一条路的另一种讲法。'
          : '按发布顺序排着。'}
      </p>
    </section>

    {placeholderCount > 0 && (
      <div class="boundary">
        <b>这 {placeholderCount} 期是占位稿。</b>
        内容还没定稿——先当草稿看，别当准。
      </div>
    )}

    {groups.map((group) => (
      <section class="section">
        <h3><a href={`/learning/${group.track.id}/`}>{group.track.title}</a></h3>
        {group.stages.map((g) => (
          <div class="stage-block">
            <div class="stage-head">
              <span class="lv">{g.stage.id}</span>
              <span>{g.stage.title}</span>
            </div>
            <ul class="unit-list">
              {g.units.map((unit) => unit && (
                <li class="vid-row">
                  <UnitRow unit={unit} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    {/* 学习流关着的时候，视频平铺着列——不按赛道分组。 */}
    {groups.length === 0 && videos.length > 0 && (
      <section class="section">
        <ul class="unit-list">
          {videos.map((unit) => (
            <li class="vid-row">
              <UnitRow unit={unit} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {videos.length === 0 && <p class="muted">还没有视频。</p>}
  </div>
</Base>

<style>
  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stage-block {
    margin: 10px 0 0;
    padding-left: 12px;
    border-left: 2px solid var(--line);
  }

  .stage-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .stage-head .lv {
    font-weight: 800;
    color: var(--brand);
    font-size: 12px;
  }
</style>
