---
/**
 * 关于页。
 *
 * **正文由使用者写**：`content/about.md`（站点私产，不是内容单元）。
 * 框架只补一段自动生成的「现在有什么」——数字从编译结果里数出来，
 * 不写死，改了内容它自己变。
 *
 * 用户还没写 about.md 时，页面给一份兜底（站点简介 + 同样的统计）。
 */
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allUnits } from '../../lib/units';
import { tracks } from '../../lib/learning';
import { siteDescription, siteName } from '../../lib/site';

const units = await allUnits();
const documents = units.filter((u) => u.data.kind !== 'category');
const videos = units.filter((u) => u.data.kind === 'video');
const stages = tracks.reduce((n, t) => n + t.stages.length, 0);

const pages = await getCollection('pages');
const about = pages.find((p) => p.id === 'about');
const { Content } = about ? await render(about) : { Content: null };
---

<Base title="关于" nav="about" description={about?.data.description ?? siteDescription}>
  <div class="wrap">
    <section class="section prose">
      {Content ? (
        <>
          <h1>{about!.data.title}</h1>
          <Content />
        </>
      ) : (
        <>
          <h1>关于 {siteName}</h1>
          <p>{siteDescription}</p>
        </>
      )}

      <h2>现在有什么</h2>
      <ul>
        {tracks.length > 0 && <li>{tracks.length} 条赛道，共 {stages} 个阶段</li>}
        <li>{documents.length} 篇内容（其中 {videos.length} 期视频）</li>
        <li>内容按审校进度上站，所以现在还很薄——这是有意的</li>
      </ul>
    </section>
  </div>
</Base>
