---
/**
 * 学习流的三个页面：总览 / 赛道 / 阶段。
 *
 * **合并成一个路由**是刻意的：学习流是一个**可选的模块**
 * （规则表 `data/learning-path.json` 里 `enabled: false` 就整个关掉）。
 * 模块关掉时，`getStaticPaths` 返回空数组——**一个学习流页面都不生成**，
 * 而不是留一堆空页在那里。静态路由做不到这件事（文件在，页面就在）。
 *
 * 路径形状：
 * - `/learning/`                 总览（rest 参数为 undefined）
 * - `/learning/<赛道>/`          一条赛道
 * - `/learning/<赛道>/<阶段>/`   一格
 */
import Base from '../../layouts/Base.astro';
import LearningIndex from '../../components/learning/LearningIndex.astro';
import TrackView from '../../components/learning/TrackView.astro';
import StageView from '../../components/learning/StageView.astro';
import { tracks, enabled } from '../../lib/learning';
import type { Track, Stage } from '../../lib/learning';

export function getStaticPaths() {
  const paths: {
    params: { path: string | undefined };
    props: { kind: 'index' | 'track' | 'stage'; track?: Track; stage?: Stage };
  }[] = [];

  // 模块关着 → 一个页面都不生成（静态路由做不到这件事）。
  if (!enabled) return paths;

  for (const track of tracks) {
    for (const stage of track.stages) {
      paths.push({
        params: { path: `${track.id}/${stage.id}` },
        props: { kind: 'stage', track, stage },
      });
    }
    paths.push({ params: { path: track.id }, props: { kind: 'track', track } });
  }

  paths.push({ params: { path: undefined }, props: { kind: 'index' } });
  return paths;
}

const { kind, track, stage } = Astro.props;

const title = kind === 'index' ? '学习流' : kind === 'track' ? track!.title : `${stage!.id} ${stage!.title}`;
const description =
  kind === 'index'
    ? `学习流总览：${tracks.length} 条赛道，每条是一串从入门到深入的阶段。`
    : kind === 'track'
      ? track!.summary
      : `${track!.title} · ${stage!.title}：${stage!.goal}`;
---

<Base title={title} nav="learning" description={description}>
  {kind === 'index' && <LearningIndex />}
  {kind === 'track' && track && <TrackView track={track} />}
  {kind === 'stage' && track && stage && <StageView track={track} stage={stage} />}
</Base>
