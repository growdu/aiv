---
/**
 * 时间轴：四个数字 + 逐月的日子与挂在上面的东西。
 *
 * 数据全部来自两处：站点的账本（`data/activity.json`），
 * 和 `docs/` 编译出来的内容单元。站点不挖仓库的旧历史——
 * **往后的账自己攒**，所以这一页是活的：每天多一条，它就多一天。
 */
import Base from '../layouts/Base.astro';
import StatBar from '../components/StatBar.astro';
import Timeline from '../components/Timeline.astro';
import { range, days, learnLines } from '../lib/activity';
import { siteName } from '../lib/site';

const activeDays = days.filter((day) => day.write || day.ai).length;

const rules = [
  {
    name: '写作',
    desc: '当天站上有东西写出来——内容单元的日期落在那天。写完了还没过审、还没上站的日子，在账本里补一条。',
  },
  {
    name: '学习',
    desc: `当天写出来的东西落在技术线（${learnLines.join('、')}）——读源码、读实现的那部分。`,
  },
  {
    name: '用 AI',
    desc: '当天有产出就算用了 AI；账本里可以显式改成「那天没用」。',
  },
  {
    name: '偷懒',
    desc: '既没产出、账本里也没记的日子——空档。它跟上面三个互为反面。',
  },
];
---

<Base title="时间轴" nav="timeline" description={`${siteName} 的写作时间轴：写了多少天、偷懒多少天、学了多少天、用了多少 AI。`}>
  <div class="wrap">
    <section class="section">
      <h1>时间轴</h1>
      <p class="section-sub">
        从 {range.start} 到 {range.end}，{range.days} 天。其中 {activeDays} 天有动静。
      </p>
      <StatBar />
    </section>

    <section class="section">
      <h2>这四个数怎么来的</h2>
      <p class="section-sub">
        上面四个数里，<b>大数是「连着多少天」，小字才是累计</b>。
        口径写在站点的账本里（<code>site/data/activity.json</code>），改口径不用改代码。
      </p>
      <dl class="rules">
        {rules.map((rule) => (
          <div class="rule">
            <dt>{rule.name}</dt>
            <dd>{rule.desc}</dd>
          </div>
        ))}
      </dl>
      <p class="section-sub" style="margin-top:10px">
        账本只增不改：历史不回头补，往后一天一天攒。<code>npm run activity -- --append</code> 把今天记进去。
      </p>
    </section>

    <section class="section">
      <h2>逐月</h2>
      <p class="section-sub">一格一天：颜色越深写得越多，琥珀色是「用了 AI 但没写稿」。</p>
      <Timeline />
    </section>
  </div>
</Base>

<style>
  .rules {
    margin: 0;
  }

  .rule {
    display: flex;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--line-soft);
  }

  .rule:last-child {
    border-bottom: none;
  }

  .rule dt {
    flex: 0 0 64px;
    color: var(--ink);
    font-weight: 700;
  }

  .rule dd {
    margin: 0;
    color: var(--body);
    font-size: 14.5px;
  }

  code {
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
</style>
