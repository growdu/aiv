{
  "name": "blog-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "站点的 Astro 实现：目录树 + 学习流 + 时间轴。身份与结构由 data/site.json 定义。",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run compile && npm run activity && npm run sync && astro build",
    "preview": "astro preview",
    "compile": "python3 tools/build-learning-path.py",
    "activity": "python3 tools/build-activity.py",
    "sync": "python3 tools/sync-content.py",
    "check": "python3 tools/check-markdown.py",
    "test": "python3 -m pytest tests/ -q"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "mermaid": "^12.3.0"
  }
}
